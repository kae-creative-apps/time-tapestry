# Copy to .env.local for local development. Never commit real credentials.
# Restart Next.js after changes. The story film worker loads .env.local itself.
# Some other CLI scripts need their environment supplied explicitly, for example
# node --env-file=.env.local --import tsx ...

# Origin serving the application. Match the development port you use.
# Production print/email links require the correct public HTTPS app origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local collection records and recordings. Empty uses .data/collections.
COLLECTION_DATA_DIR=

# Durable collection storage. BOTH values are required on Vercel.
# Missing configuration fails closed there, without an ephemeral-file fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloud recordings and finished videos require a PRIVATE Vercel Blob store.
# Public stores are rejected. Leave empty for local filesystem media.
BLOB_READ_WRITE_TOKEN=

# Required for public signup and recipient email verification.
# Create Turnstile keys for the public app hostname. Never use local bypasses
# on a public deployment. The site key is intentionally public; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional separate secret for opaque rate-limit buckets.
SECURITY_HASH_SECRET=
SECURITY_PROVIDER_DAILY_LIMIT=500

# Gloo: source-based story drafts and adaptive follow-ups.
# Without a key, the new journey preserves source text and configured questions.
GLOO_API_KEY=
GLOO_MODEL=gloo-google-gemini-2.5-flash

# OpenAI Whisper transcription. Do not substitute a Gloo API key.
# Missing configuration retains recordings and allows typed correction.
OPENAI_API_KEY=

# ElevenLabs interviewer voice. Audition before real family use.
# Generated narration and question playback use this agent's voice and settings.
# If ElevenLabs is unavailable, keep written questions and recordings available.
ELEVENLABS_API_KEY=
# Reuse the existing private interviewer documented in docs/LIVE_INTERVIEW_SETUP.md.
ELEVENLABS_AGENT_ID=

# Film worker: uses only the storyteller’s original recorded voice.
# Run the worker separately from Next.js. See docs/STORY_FILM_WORKER.md.
# Required for hosted workers outside Railway; Railway is detected automatically.
# The Docker worker image sets this itself. Leave false for local development.
STORY_FILM_WORKER_HOSTED=false
# Working-volume safety floor, in bytes. Defaults to 1 GiB; never a quota.
STORY_FILM_MIN_FREE_BYTES=1073741824
STORY_FILM_TTS_MODEL=eleven_multilingual_v2
STORY_FILM_DAILY_LIMIT=3
# Empty uses the committed public/brand/film-closer-v2.mp4.
STORY_FILM_CLOSER_FILE=

# Outbound collection delivery is disabled by default, even with keys present.
# Enable only after the operator checks docs/DELIVERY_SETUP.md.
COLLECTION_DELIVERY_ENABLED=false
# Optional queued email-only delivery. Account sign-in emails have their own
# security checks and do not depend on either collection delivery flag.
COLLECTION_EMAIL_ENABLED=false

# Generate a unique private secret before configuring the worker scheduler.
# Protects GET/POST /api/collection/jobs. No cron is installed automatically.
CRON_SECRET=

# Lob postcard delivery. Use an approved return-address ID.
# Configure POST /api/collection/webhooks/lob with its actual signing secret.
# Test cards do not supply proof of mailing. Never use "secret" for webhooks.
LOB_API_KEY=
LOB_FROM_ADDRESS_ID=
LOB_WEBHOOK_SECRET=

# Resend email delivery. Set an identity on a verified sending domain.
# Example format only: Time Tapestry <stories@example.org>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin uses the existing verified email-link account flow and a fixed team allowlist.
# There is no ADMIN_SECRET or separate admin password.

# Optional resource-policy overrides. Empty keeps the documented defaults.
# Originals, rendered films and pending uploads share the per-collection budget.
COLLECTION_STORAGE_LIMIT_BYTES=
COLLECTION_METADATA_LIMIT_BYTES=
COLLECTION_CONVERSATION_LIMIT=
# Local offline backup destination. See docs/BACKUP_RUNBOOK.md before use.
COLLECTION_BACKUP_DIR=
