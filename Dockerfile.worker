# Dedicated film worker. The website continues to run on Vercel.
FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates fonts-liberation tini \
    libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libgbm1 libasound2 \
    libxrandr2 libxkbcommon0 libxfixes3 libxcomposite1 libxdamage1 \
    libpango-1.0-0 libcairo2 libcups2 libdrm2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
# tsx and build tooling are required at runtime; use the committed lockfile.
RUN npm ci --include=dev --no-audit --no-fund \
    && npx --no-install remotion browser ensure \
    && npm cache clean --force

# Explicit copies prevent local recordings, credentials and handoff files
# from being baked into an image, including one built from a developer laptop.
COPY tsconfig.json ./
COPY src/lib ./src/lib
COPY src/components/BrandArtwork.tsx src/components/BrandPattern.tsx ./src/components/
COPY scripts/run-story-film-worker.ts scripts/verify-worker-container.ts ./scripts/
COPY video/src ./video/src
COPY video/remotion ./video/remotion
COPY public/brand/film-closer-v2.mp4 ./public/brand/film-closer-v2.mp4
COPY public/brand/fonts/quicksand-latin.woff2 ./public/brand/fonts/quicksand-latin.woff2

ENV NODE_ENV=production \
    STORY_FILM_WORKER_HOSTED=true \
    COLLECTION_DATA_DIR=/data
RUN mkdir -p /data && chmod 700 /data

# Railway mounts volumes as root. No network listener or public domain is needed.
# tini reaps Chrome/FFmpeg children and forwards termination to the worker.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--import", "tsx", "scripts/run-story-film-worker.ts"]
